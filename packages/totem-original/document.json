    {
      "id": "assembly",
      "name": "Robotic assembly",
      "mode": "fullscreen",
      "elements": [
        {
          "id": "assembly-title",
          "type": "text",
          "x": 56,
          "y": 1010,
          "width": 968,
          "height": 100,
          "text": "Computer vision for robotic assembly",
          "locked": true
        },
        {
          "id": "assembly-lead",
          "type": "text",
          "x": 56,
          "y": 1130,
          "width": 968,
          "height": 240,
          "text": "A collaborative robot with a camera built into its wrist rides on a track beside the line. It spots the car, locks onto the exact assembly point and travels with the car while it fits the part, so the line never has to stop.",
          "locked": true
        }
      ]
    },
    {
      "id": "lab",
      "name": "Lab automation",
      "mode": "fullscreen",
      "elements": [
        {
          "id": "lab-title",
          "type": "text",
          "x": 56,
          "y": 1010,
          "width": 968,
          "height": 100,
          "text": "Vision‑guided lab automation",
          "locked": true
        },
        {
          "id": "lab-lead",
          "type": "text",
          "x": 56,
          "y": 1130,
          "width": 968,
          "height": 240,
          "text": "The same collaborative robot, now on a lab bench. Its camera reads the rack and finds the right test tube; the arm carries it into the analyser and the run starts. Repetitive sample handling becomes fast, safe and repeatable.",
          "locked": true
        }
      ]
    },
    {
      "id": "caricature",
      "name": "AI caricatures",
      "mode": "fullscreen",
      "elements": [
        {
          "id": "caricature-title",
          "type": "text",
          "x": 56,
          "y": 1010,
          "width": 968,
          "height": 100,
          "text": "AI caricatures, drawn by a robot",
          "locked": true
        },
        {
          "id": "caricature-lead",
          "type": "text",
          "x": 56,
          "y": 1130,
          "width": 968,
          "height": 240,
          "text": "A camera captures your face and AI picks out what makes it unique. Then the robot takes the pen and draws your caricature, stroke by stroke, right in front of you.",
          "locked": true
        }
      ]
    },
    {
      "id": "sifu",
      "name": "Music without barriers",
      "mode": "fullscreen",
      "elements": [
        {
          "id": "sifu-title",
          "type": "text",
          "x": 56,
          "y": 1010,
          "width": 968,
          "height": 100,
          "text": "Music without barriers, with Fundación SIFU",
          "locked": true
        },
        {
          "id": "sifu-lead",
          "type": "text",
          "x": 56,
          "y": 1130,
          "width": 968,
          "height": 240,
          "text": "At Fundación SIFU’s SuperArte Gala in Madrid, a young pianist with cerebral palsy played a grand piano with his eyes. He picks each note on an eye‑tracking instrument; our AI predicts the next note, so the robot arm is already at the key when he plays it.",
          "locked": true
        }
      ]
    },
    {
      "id": "dpcr",
      "name": "Digital PCR diagnostics",
      "mode": "fullscreen",
      "elements": [
        {
          "id": "dpcr-title",
          "type": "text",
          "x": 56,
          "y": 1010,
          "width": 968,
          "height": 100,
          "text": "Digital PCR for molecular diagnostics",
          "locked": true
        },
        {
          "id": "dpcr-lead",
          "type": "text",
          "x": 56,
          "y": 1130,
          "width": 968,
          "height": 240,
          "text": "We engineer software for molecular diagnostic devices like this digital PCR system. Load a sealed plate and it does the rest on its own: it splits each sample into thousands of partitions, runs the PCR and images every partition for a precise, absolute result.",
          "locked": true
        }
      ]
    }
