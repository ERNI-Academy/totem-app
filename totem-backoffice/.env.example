# Local development only. Copy to .env.local and fill with the DEV database credentials.
APP_ENV=local
NEXT_PUBLIC_APP_ENV_LABEL=Local
DATABASE_URL="Server=tcp:<dev-server>.database.windows.net,1433;Initial Catalog=totem-db-dev;Persist Security Info=False;User ID=totem_app_dev;Password=<dev-password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
AUTH_SESSION_SECRET=<random-secret-at-least-32-characters>
INITIAL_ADMIN_SETUP_KEY=<separate-random-secret-at-least-24-characters>
AZURE_STORAGE_CONNECTION_STRING="<dev-storage-account-connection-string>"
AZURE_STORAGE_CONTAINER=totem-media-dev
