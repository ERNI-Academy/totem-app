# Local development. Copy to .env.local and keep it out of Git.
APP_ENV=local
NEXT_PUBLIC_APP_ENV_LABEL=Local
POSTGRES_PASSWORD=replace-with-32-byte-hex-secret
DATABASE_URL=postgresql://totem_app:replace-with-32-byte-hex-secret@127.0.0.1:5432/totem_dev
AUTH_SESSION_SECRET=<random-secret-at-least-32-characters>
INITIAL_ADMIN_SETUP_KEY=<separate-random-secret-at-least-24-characters>
AZURE_STORAGE_CONNECTION_STRING="<dev-storage-account-connection-string>"
AZURE_STORAGE_CONTAINER=totem-media-dev
