# Reference only. Set these as Production Environment Variables in Vercel.
APP_ENV=production
NEXT_PUBLIC_APP_ENV_LABEL=Production
DATABASE_URL="Server=tcp:<prod-server>.database.windows.net,1433;Initial Catalog=totem-db;Persist Security Info=False;User ID=totem_app;Password=<prod-password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
AUTH_SESSION_SECRET=<unique-production-random-secret-at-least-32-characters>
INITIAL_ADMIN_SETUP_KEY=<temporary-unique-production-secret-at-least-24-characters>
AZURE_STORAGE_CONNECTION_STRING="<production-storage-account-connection-string>"
AZURE_STORAGE_CONTAINER=totem-media
